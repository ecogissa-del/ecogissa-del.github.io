---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

import fs from 'node:fs';
import path from 'node:path';


/* =========================================================
   LOCALIZA TODAS AS IMAGENS DE UMA PASTA
========================================================= */

function imagensDaPasta(pastaRelativa: string): string[] {

  const pastaCompleta = path.join(
    process.cwd(),
    'public',
    pastaRelativa
  );

  if (!fs.existsSync(pastaCompleta)) {
    return [];
  }

  const extensoesPermitidas = [
    '.jpg',
    '.jpeg',
    '.png',
    '.webp',
    '.avif'
  ];

  const imagens: string[] = [];


  function percorrerPasta(
    pastaAtual: string,
    caminhoPublicoAtual: string
  ) {

    const itens = fs.readdirSync(
      pastaAtual,
      { withFileTypes: true }
    );


    itens.forEach((item: fs.Dirent) => {

      const caminhoCompleto = path.join(
        pastaAtual,
        item.name
      );

      const caminhoPublico =
        `${caminhoPublicoAtual}/${item.name}`;


      if (item.isDirectory()) {

        percorrerPasta(
          caminhoCompleto,
          caminhoPublico
        );

        return;
      }


      const extensao = path
        .extname(item.name)
        .toLowerCase();


      if (extensoesPermitidas.includes(extensao)) {

        imagens.push(
          encodeURI(`/${caminhoPublico}`)
        );

      }

    });

  }


  percorrerPasta(
    pastaCompleta,
    pastaRelativa
  );


  return imagens.sort();
}



/* =========================================================
   SERVIÇOS DA ECOGIS

   Os nomes em "pasta" correspondem exatamente às pastas em:
   public/images/servicos/
========================================================= */

